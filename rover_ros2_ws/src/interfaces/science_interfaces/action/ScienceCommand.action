# Commands the science sequencer sends to the embedded driver.
# Elevator move targets are motor steps from home.
string command
float64 value
---
# Set success once the driver confirms the requested change is complete.
bool success
string message
float64 actual_value
float64[] readings
string[] units
# Provisional fault report. An empty code means the driver has no specific diagnosis.
string fault_code
bool elevator_position_valid
---
float64 progress
string detail
