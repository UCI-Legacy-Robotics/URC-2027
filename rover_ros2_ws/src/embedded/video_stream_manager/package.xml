<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>video_stream_manager</name>
  <version>0.1.0</version>
  <description>Encodes rover camera images to H.264 and publishes them to the rover's MediaMTX.</description>
  <maintainer email="TODO@todo.com">Ethan Shih</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>pkg-config</build_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>

  <build_depend>libgstreamer1.0-dev</build_depend>
  <build_depend>libgstreamer-plugins-base1.0-dev</build_depend>
  <!-- appsrc, videoconvert -->
  <exec_depend>gstreamer1.0-plugins-base</exec_depend>
  <!-- jpegdec -->
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>
  <!-- x264enc -->
  <exec_depend>gstreamer1.0-plugins-ugly</exec_depend>
  <!-- h264parse -->
  <exec_depend>gstreamer1.0-plugins-bad</exec_depend>
  <!-- rtspclientsink -->
  <exec_depend>gstreamer1.0-rtsp</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
