<?xml version="1.0" encoding="utf-8"?>
<!-- Converted from the SolidWorks URDF export of "26 MasterCad Suspension-Chassis Test".
     Link frames sit on the real pivots (measured from the meshes); x forward, z up.
     Joint limits on rockers, bogies and steering are placeholders - set them to the real hardware stops. -->
<robot name="drive_description">

  <link name="base_footprint"/>
