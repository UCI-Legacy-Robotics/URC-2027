<?xml version="1.0"?>
<robot name="arm">
  <group name="arm">
    <chain base_link="base_mount" tip_link="claw" />
  </group>
  <group name="Gripper">
    <joint name="claw_to_right_grip" />
    <joint name="claw_to_left_grip" />
  </group>
  <group name="Solenoid">
    <joint name="grip_to_solenoid" />
  </group>
  <end_effector name="gripper_end_effector" parent_link="claw" group="Gripper" parent_group="arm" />
  <disable_collisions link1="base_mount" link2="upper_base" reason="Adjacent" />
  <disable_collisions link1="claw" link2="claw_camera" reason="Adjacent" />
  <disable_collisions link1="claw" link2="left_gripper" reason="Adjacent" />
  <disable_collisions link1="claw" link2="right_gripper" reason="Adjacent" />
  <disable_collisions link1="claw" link2="solenoid" reason="Never" />
  <disable_collisions link1="claw" link2="wrist" reason="Adjacent" />
  <disable_collisions link1="claw_camera" link2="left_gripper" reason="Never" />
  <disable_collisions link1="claw_camera" link2="right_gripper" reason="Never" />
  <disable_collisions link1="claw_camera" link2="solenoid" reason="Never" />
  <disable_collisions link1="claw_camera" link2="wrist" reason="Never" />
  <disable_collisions link1="elbow" link2="shoulder" reason="Adjacent" />
  <disable_collisions link1="elbow" link2="wrist" reason="Adjacent" />
  <disable_collisions link1="left_gripper" link2="solenoid" reason="Adjacent" />
  <disable_collisions link1="left_gripper" link2="wrist" reason="Never" />
  <disable_collisions link1="right_gripper" link2="solenoid" reason="Never" />
  <disable_collisions link1="right_gripper" link2="wrist" reason="Never" />
  <disable_collisions link1="shoulder" link2="upper_base" reason="Adjacent" />
  <disable_collisions link1="shoulder" link2="wrist" reason="Never" />
  <disable_collisions link1="solenoid" link2="wrist" reason="Never" />
  <group_state name="home" group="arm">
    <joint name="base_mount_to_upper_base" value="0.0" />
    <joint name="upper_base_to_shoulder" value="0.0" />
    <joint name="shoulder_to_elbow" value="0.0" />
    <joint name="elbow_to_wrist" value="0.0" />
    <joint name="wrist_to_claw" value="0.0" />
  </group_state>
  <group_state name="open" group="Gripper">
    <joint name="claw_to_left_grip" value="0.0" />
    <joint name="claw_to_right_grip" value="0.0" />
  </group_state>
  <group_state name="partially_closed" group="Gripper">
    <joint name="claw_to_left_grip" value="0.03" />
    <joint name="claw_to_right_grip" value="0.03" />
  </group_state>
  <group_state name="retracted" group="Solenoid">
    <joint name="grip_to_solenoid" value="0.0" />
  </group_state>
  <group_state name="extended" group="Solenoid">
    <joint name="grip_to_solenoid" value="0.015" />
  </group_state>
</robot>
