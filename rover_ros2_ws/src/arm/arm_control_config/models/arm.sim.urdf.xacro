<?xml version="1.0"?>
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_gazebo" default="true"/>
  <xacro:arg name="controllers_file" default="$(find arm_control_config)/config/ros2_controllers.yaml"/>
  <xacro:arg name="initial_positions_file" default="$(find arm_control_config)/config/initial_positions.yaml"/>
  <xacro:include filename="$(find arm)/description/arm.urdf"/>
  <xacro:include filename="arm.ros2_control.xacro"/>
  <xacro:include filename="arm.gazebo.xacro"/>
  <xacro:arm_ros2_control use_gazebo="$(arg use_gazebo)" initial_positions_file="$(arg initial_positions_file)"/>
  <xacro:if value="$(arg use_gazebo)">
    <xacro:arm_gazebo controllers_file="$(arg controllers_file)"/>
  </xacro:if>
</robot>
