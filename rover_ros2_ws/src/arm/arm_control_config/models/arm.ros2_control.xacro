<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arm_control_joint" params="name initial_positions command_interface:=position">
    <joint name="${name}">
      <command_interface name="${command_interface}"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions[name]}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="arm_ros2_control" params="use_gazebo initial_positions_file">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <ros2_control name="ArmSystem" type="system">
      <hardware>
        <xacro:if value="${use_gazebo}"><plugin>gz_ros2_control/GazeboSimSystem</plugin></xacro:if>
        <xacro:unless value="${use_gazebo}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:unless>
      </hardware>
      <xacro:arm_control_joint name="base_mount_to_upper_base" initial_positions="${initial_positions}"/>
      <xacro:arm_control_joint name="upper_base_to_shoulder" initial_positions="${initial_positions}"/>
      <xacro:arm_control_joint name="shoulder_to_elbow" initial_positions="${initial_positions}"/>
      <xacro:arm_control_joint name="elbow_to_wrist" initial_positions="${initial_positions}"/>
      <xacro:arm_control_joint name="wrist_to_claw" initial_positions="${initial_positions}"/>
      <xacro:arm_control_joint name="claw_to_left_grip" initial_positions="${initial_positions}" command_interface="velocity"/>
      <xacro:arm_control_joint name="claw_to_right_grip" initial_positions="${initial_positions}" command_interface="velocity"/>
      <xacro:arm_control_joint name="grip_to_solenoid" initial_positions="${initial_positions}"/>
    </ros2_control>
  </xacro:macro>
</robot>
